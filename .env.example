# Optional outbound proxy:
# PROXY=http://username:password@your-proxy-address:port

ORIGIN_PORT=8000
APP_VERSION=v4.0.0
SESSION_SECRET=replace-with-a-long-random-value
HEALTHCHECK_TOKEN=replace-with-a-long-random-value
VIENEU_CHUNK_SIZE=500
VIENEU_WARMUP_ITERATIONS=1
VIENEU_SAMPLE_RATE=48000
TTS_STREAM_FIRST_BYTE_TIMEOUT_SECONDS=300
TTS_MAX_TEXT_LENGTH=100000
VIENEU_MAX_WORDS=5000
TTS_MAX_QUEUE_SIZE=20
LOCAL_TTS_MAX_CONCURRENT=2
LOCAL_TTS_JOB_TIMEOUT_SECONDS=900
UPLOAD_MAX_SIZE_MB=50
UPLOAD_SESSION_EXPIRY_HOURS=6
AUDIO_CACHE_RETENTION_HOURS=6
RUNTIME_STORAGE_QUOTA_GB=10
RUNTIME_STORAGE_MIN_FREE_GB=2
EXTRACTED_TEXT_MAX_CHARS=2000000
EPUB_MAX_ENTRIES=1000
EPUB_MAX_ENTRY_BYTES=52428800
EPUB_MAX_UNCOMPRESSED_BYTES=209715200
EPUB_MAX_COMPRESSION_RATIO=100
ENABLE_GLOBAL_CACHE_CLEAR=false

APP_MEMORY_LIMIT=4g
APP_CPU_LIMIT=2.0
APP_PIDS_LIMIT=256
VIENEU_MEMORY_LIMIT=6g
VIENEU_CPU_LIMIT=3.0
VIENEU_PIDS_LIMIT=256
REDIS_MEMORY_LIMIT=192m
REDIS_CPU_LIMIT=0.5
REDIS_PIDS_LIMIT=100

# Exact IP/CIDR of the reverse proxy as seen by Uvicorn. Never use *.
FORWARDED_ALLOW_IPS=
# Set true when the public site uses HTTPS.
SESSION_COOKIE_SECURE=false

# Optional Hugging Face access token; never commit a real value.
HF_TOKEN=
